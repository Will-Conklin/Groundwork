FROM python:3.12-slim

RUN pip install --no-cache-dir mlflow==3.12.0

# Backend store (SQLite) written to /mlflow-data — mount a volume here for persistence.
# Artifact store written to /mlruns — mount a volume here to share artifacts with notebooks.
VOLUME ["/mlflow-data", "/mlruns"]

EXPOSE 5000

CMD ["mlflow", "server", \
     "--backend-store-uri", "sqlite:////mlflow-data/mlflow.db", \
     "--artifacts-destination", "/mlruns", \
     "--host", "0.0.0.0", \
     "--port", "5000"]
